# Django Secret Key
DJANGO_SECRET_KEY=your-django-secret-key-here

# Google OAuth2 Credentials (from Google Cloud Console)
GOOGLE_OAUTH2_KEY=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_OAUTH2_SECRET=your-google-client-secret-here

# Redis Configuration (optional, falls back to in-memory FakeRedis automatically)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
